<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wensaas.core.impl.permission.role.SysRoleMapper">

    <resultMap id="RoleResultMap" type="com.wensaas.core.impl.permission.role.SysRole">
        <id     column="id"          property="id"/>
        <result column="tenant_id"   property="tenantId"/>
        <result column="code"        property="code"/>
        <result column="name"        property="name"/>
        <result column="description" property="description"/>
        <result column="status"      property="status"/>
        <result column="created_at"  property="createdAt"/>
        <result column="created_by"  property="createdBy"/>
        <result column="updated_at"  property="updatedAt"/>
        <result column="updated_by"  property="updatedBy"/>
        <result column="deleted_at"  property="deletedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, tenant_id, code, name, description, status,
        created_at, created_by, updated_at, updated_by, deleted_at
    </sql>

    <select id="listForTenant" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_role
        WHERE deleted_at IS NULL
          AND tenant_id = #{tenantId}
        ORDER BY created_at DESC
    </select>

    <select id="countByCode" resultType="int">
        SELECT COUNT(*) FROM sys_role
        WHERE deleted_at IS NULL
          AND tenant_id = #{tenantId}
          AND code = #{code}
        <if test="selfId != null">
          AND id &lt;&gt; #{selfId}
        </if>
    </select>

    <select id="countByName" resultType="int">
        SELECT COUNT(*) FROM sys_role
        WHERE deleted_at IS NULL
          AND tenant_id = #{tenantId}
          AND name = #{name}
        <if test="selfId != null">
          AND id &lt;&gt; #{selfId}
        </if>
    </select>

</mapper>
