<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wensaas.core.impl.file.share.SysFileShareMapper">

    <resultMap id="BaseResultMap" type="com.wensaas.core.impl.file.share.SysFileShare">
        <id     property="id"             column="id"/>
        <result property="tenantId"       column="tenant_id"/>
        <result property="shareToken"     column="share_token"/>
        <result property="fileId"         column="file_id"/>
        <result property="expiresAt"      column="expires_at"/>
        <result property="passwordHash"   column="password_hash"/>
        <result property="maxDownloads"   column="max_downloads"/>
        <result property="downloadCount"  column="download_count"/>
        <result property="status"         column="status"/>
        <result property="createdAt"      column="created_at"/>
        <result property="createdBy"      column="created_by"/>
        <result property="updatedAt"      column="updated_at"/>
        <result property="updatedBy"      column="updated_by"/>
        <result property="deletedAt"      column="deleted_at"/>
    </resultMap>

    <sql id="cols">
        id, tenant_id, share_token, file_id, expires_at, password_hash, max_downloads,
        download_count, status, created_at, created_by, updated_at, updated_by, deleted_at
    </sql>

    <select id="selectByToken" resultMap="BaseResultMap">
        SELECT <include refid="cols"/>
        FROM sys_file_share
        WHERE share_token = #{shareToken}
          AND deleted_at IS NULL
        LIMIT 1
    </select>

    <select id="selectAliveByFileId" resultMap="BaseResultMap">
        SELECT <include refid="cols"/>
        FROM sys_file_share
        WHERE tenant_id = #{tenantId}
          AND file_id = #{fileId}
          AND deleted_at IS NULL
        ORDER BY created_at DESC
    </select>

    <!--
      原子消费：active + 未过期 + 未超限。
      并发安全：max_downloads NULL 视为不限，IS NULL OR download_count + 1 <= max_downloads。
    -->
    <update id="tryConsume">
        UPDATE sys_file_share
           SET download_count = download_count + 1,
               updated_at = #{now}
         WHERE share_token = #{shareToken}
           AND deleted_at IS NULL
           AND status = 'active'
           AND (expires_at IS NULL OR expires_at &gt; #{now})
           AND (max_downloads IS NULL OR download_count &lt; max_downloads)
    </update>
</mapper>
