<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wensaas</groupId>
        <artifactId>wen-saas-boot-core</artifactId>
        <version>0.9.0</version>
    </parent>

    <artifactId>wen-saas-boot-core-api</artifactId>
    <name>${project.artifactId}</name>
    <description>底座扩展点接口与模型（BusinessModuleDescriptor、各注册表 API、领域模型）</description>

    <dependencies>
        <!-- Lombok：响应 DTO 可变 POJO 化 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 仅依赖 Spring 注解，不引入 starter，保持 API 模块轻量 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- 仅为 NameSourceFactory 暴露 SFunction 类型（方法引用注册名称源，M10）；
             provided：运行时由 core-impl 的 mybatis-plus starter 提供，不传递给下游 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 仅为 mq 包消费可靠性契约暴露 v5 客户端 API 类型（MessageView / ConsumeResult）；
             provided：运行时由 core-impl 的 rocketmq starter 提供同一 shaded jar，不传递给下游 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 仅用 @JsonValue/@JsonCreator 注解枚举线格式（healthy/warning/danger 小写），运行时由 core-web 的 Jackson 提供 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
