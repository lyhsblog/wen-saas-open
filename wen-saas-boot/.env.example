# Wen-SaaS 后端敏感/环境变量模板（方案 A）
# ------------------------------------------------------------------
# 用法：复制为 .env（.env 已被 .gitignore 排除，不入库），填真实值，
#       与 service.sh + jar 一同放到部署目录（默认 /data/wensaas/backend）。
#       service.sh 启动时以 `set -a; . .env; set +a` 注入为进程环境变量。
# 注意：含空格 / 尖括号等特殊字符的值必须用双引号包住（source 走 shell 解析，
#       否则 < > 会被当成重定向、空格会截断值）。
# ------------------------------------------------------------------

# ---- 阿里云邮件推送 SMTP（通知 / 验证码邮件真发所需）----
SPRING_MAIL_HOST=smtpdm.aliyun.com
SPRING_MAIL_PORT=465
# 发信地址（阿里云控制台已验证的那个），SMTP 登录名即它
SPRING_MAIL_USERNAME=no-reply@mail.example.com
# 发信地址的独立 SMTP 密码（≠ 阿里云账号密码）
SPRING_MAIL_PASSWORD=change-me
# From：显示名 + 发信地址；地址必须与 SPRING_MAIL_USERNAME 一致。双引号不可省
SPRING_MAIL_FROM="Wen-SaaS <no-reply@mail.example.com>"
# 邮件真发开关：默认 true=仅打日志不发信；置 false 才真正投递
NOTIFICATION_EMAIL_NOOP=false

# ---- 可选：部署环境与内置默认不同时按需覆盖（取消注释）----
# 文件本地存储根（相对路径随 CWD 漂移，服务器建议给绝对路径）
#WEN_SAAS_BOOT_FILE_LOCAL_ROOT=/data/wensaas/backend/data/files
# 日志目录（映射 Spring 属性 logging.file.path，logback 默认 ./logs 相对 CWD）
#LOGGING_FILE_PATH=/data/wensaas/backend/logs
# JWT 秘钥（生产必须换，≥32 字节）
#WEN_SAAS_BOOT_JWT_SECRET=
# 文件加密 AES 密钥
#WEN_SAAS_BOOT_FILE_AES_KEY=

# ---- 初始运营超管邮箱（sys_user id=1，启动时若库中为空则加密回填）----
WEN_SAAS_BOOT_OPS_INITIAL_ADMIN_EMAIL=ops-admin@example.com
