# 复制为 .env 后修改（.env 勿提交 git）。compose 的 backend 通过 env_file 加载。

# ---- 中间件 ----
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# ---- 生产密钥（不可用仓库 dev 默认值，否则 prod 拒绝启动）----
# 生成示例：openssl rand -base64 32
WEN_SAAS_BOOT_JWT_SECRET=replace-with-openssl-rand-base64-32-bytes-min
# Spring 绑定 wen-saas-boot.mfa.secret-key / secret-salt 的变量名（见 ConfigurationProperties）
WEN_SAAS_BOOT_MFA_SECRET_KEY=replace-with-random-string-at-least-16-chars
WEN_SAAS_BOOT_MFA_SECRET_SALT=replace-with-hex-16-chars-min-like-a1b2c3d4e5f67890
# 32 字节 AES 密钥 Base64：openssl rand -base64 32
WEN_SAAS_BOOT_FILE_AES_KEY=replace-with-openssl-rand-base64-32

# ---- 运营超管邮箱（种子账号 admin@ops 首次启动回填）----
WEN_SAAS_BOOT_OPS_INITIAL_ADMIN_EMAIL=ops-admin@567cc.cc

# ---- 前端构建域名（改域后需 docker compose up -d --build gateway）----
VITE_TENANT_BASE_DOMAIN=567cc.cc
VITE_TENANT_WEB_ORIGIN=https://567cc.cc
VITE_H5_WEB_ORIGIN=https://m.567cc.cc

# ---- 可选：邮件真发（默认 NOTIFICATION_EMAIL_NOOP=true 仅打日志）----
# NOTIFICATION_EMAIL_NOOP=true

# ---- 可选：构建镜像源 ----
# MAVEN_MIRROR=https://repo.maven.apache.org/maven2
# NPM_REGISTRY=https://registry.npmjs.org
